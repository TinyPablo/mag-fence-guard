# PlatformIO / ESP32 build artifacts - regenerated on every build, no reason to track them
.pio/
.pioenvs/
.piolibdeps/

# Editor/IDE local settings - personal to each machine, not project config
.vscode/
.idea/

# OS junk files that macOS/Windows scatter into folders
.DS_Store
Thumbs.db

# Local secrets (WiFi credentials, API keys) - never commit real values,
# only the .example templates
secrets.h
secrets.py
.env

# Personal test recordings from the audio-wifi-relay debug harness - not
# project content, see docs/audio.md
tools/audio-wifi-relay/recordings/

# Generated Thonny firmware update bundles
/updates/
__pycache__/
