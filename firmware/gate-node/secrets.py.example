# Copy this file to secrets.py (same folder) and fill in real values, then
# upload BOTH files to the board with Thonny. secrets.py is meant to stay
# out of git - real WiFi credentials never get committed.

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# Integrated scripts: "auto" selects the strongest visible known BSSID at
# startup. "router" or "ap" manually pins a device. The standalone duplex
# script still requires "router" or "ap".
SOURCE = "auto"

# Static IP for THIS board (used by duplex and remote-unlock tests). Set on
# connect so it never drifts with DHCP renewals. Use 192.168.1.237 on one
# board and 192.168.1.238 on the other - pick addresses outside your
# router's DHCP range so it never hands them out to something else.
STATIC_IP = "192.168.1.237"

# IP address of the OTHER ESP32-S3 board (not this one). For the
# sender/receiver test scripts this can be whatever DHCP assigns the peer -
# check with wlan.ifconfig() after it connects. For the duplex script, use
# the peer's STATIC_IP (192.168.1.238 if this board is .237, and vice
# versa).
PEER_IP = "192.168.1.238"
PEER_PORT = 5006
