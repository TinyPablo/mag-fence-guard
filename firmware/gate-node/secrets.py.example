# Copy this file to secrets.py (same folder) and fill in real values, then
# upload BOTH files to the board with Thonny. secrets.py is gitignored -
# real WiFi credentials never get committed.

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# Your Mac's local IP on the same WiFi network - check with
# System Settings -> WiFi -> Details, or `ifconfig | grep inet` in Terminal.
SERVER_IP = "192.168.1.50"
SERVER_PORT = 5005
