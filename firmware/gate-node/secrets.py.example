# Copy this file to secrets.py (same folder) and fill in real values, then
# upload BOTH files to the board with Thonny. secrets.py is meant to stay
# out of git - real WiFi credentials never get committed (see the .gitignore
# note in docs/audio.md if this file itself isn't excluded yet).

WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# IP address of the OTHER ESP32-S3 board (not this one). Run the receiver
# first - it prints its own IP on connect - then hardcode that IP here on
# the sender board's secrets.py. DHCP means this can change on reconnect;
# re-check if the peer stops responding.
PEER_IP = "192.168.1.113"
PEER_PORT = 5006
